# Brevo (formerly Sendinblue) Configuration
# Get your API key from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your_brevo_api_key_here

# Optional: Brevo List ID to add subscribers to a specific list
# You can find your list IDs at: https://app.brevo.com/contacts/lists
BREVO_LIST_ID=your_list_id_here

# Optional: Brevo List ID for PDF downloads (can be same as BREVO_LIST_ID or different)
BREVO_PDF_LIST_ID=your_pdf_list_id_here

# Optional: Brevo List ID for publish requests
BREVO_PUBLISH_LIST_ID=your_publish_list_id_here

# Email Configuration
# The email address that will receive form submissions
ADMIN_EMAIL=your-email@example.com

# Sender email for notifications (must be a verified sender in Brevo)
BREVO_SENDER_EMAIL=noreply@yourdomain.com
BREVO_SENDER_NAME=Cultural Initiative

# Google Sheets Configuration
GOOGLE_SHEET_ID=your_google_sheet_id_here
# Paste the whole service-account JSON on ONE line, wrapped in single quotes
GOOGLE_SERVICE_ACCOUNT_KEY='{"type":"service_account",...}'
# Tab (worksheet) that receives new program registrations. Defaults to "الدفعة الثانية".
GOOGLE_SHEET_TAB=الدفعة الثانية

# Directory where uploaded CVs and editor images are stored.
# On Render this MUST be the mount path of a persistent disk, otherwise
# uploads are wiped on every restart/deploy. Locally use a project folder.
#   Render:  /uploads      Local:  ./uploads
UPLOADS_DIR=./uploads

# ============================================================
# Article CMS (admin) — REQUIRED for the article management UI
# ============================================================

# Neon Postgres connection string. Create a free project at
# https://neon.tech and copy the pooled connection string.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Secret used to sign session cookies. Generate a strong random value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_string

# Single shared admin login.
ADMIN_USERNAME=admin

# Hashed admin password (NEVER store the plaintext password).
# Generate with:  npm run hash-password -- "your-strong-password"
ADMIN_PASSWORD_HASH=scrypt$generate_me_with_the_command_above

# Optional: deploy hook for the مجتمع الكتابة (write-community) site. The
# write-community site is a static export that reads its articles from this
# CMS at build time, so it must rebuild to show article changes. When set,
# the CMS POSTs to this URL whenever a write-community article is created /
# updated / deleted to trigger a redeploy (e.g. a Netlify/Render build hook).
WRITE_COMMUNITY_DEPLOY_HOOK_URL=
