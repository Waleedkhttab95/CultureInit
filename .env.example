# Brevo (formerly Sendinblue) Configuration
# Get your API key from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your_brevo_api_key_here

# Optional: Brevo List ID to add subscribers to a specific list
# You can find your list IDs at: https://app.brevo.com/contacts/lists
BREVO_LIST_ID=your_list_id_here

# Optional: Brevo List ID for PDF downloads (can be same as BREVO_LIST_ID or different)
BREVO_PDF_LIST_ID=your_pdf_list_id_here

# Optional: Brevo List ID for publish requests
BREVO_PUBLISH_LIST_ID=your_publish_list_id_here

# Email Configuration
# The email address that will receive form submissions
ADMIN_EMAIL=your-email@example.com

# Sender email for notifications (must be a verified sender in Brevo)
BREVO_SENDER_EMAIL=noreply@yourdomain.com
BREVO_SENDER_NAME=Cultural Initiative

# Google Sheets Configuration
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_SERVICE_ACCOUNT_KEY=your_service_account_json_here

# Google Drive - folder ID where CVs will be stored (optional, uploads to root if not set)
# Create a folder in Google Drive and share it with your service account email
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id_here
